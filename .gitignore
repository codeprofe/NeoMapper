# .NET 8 .gitignore

## Build results
bin/
obj/
out/

obj/Debug/
obj/Release/

## User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

## Visual Studio Code
.vscode/

## Rider
.idea/
*.sln.iml

## ASP.NET Scaffolding
ScaffoldingReadMe.txt

## Dotnet watch
**/node_modules/
**/bower_components/

## Logs
*.log

## NuGet
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
!**/packages/build/
!**/packages/repositories.config

## DotCover
*.dotCover

## Coverage results
coverage/
*.coverage
*.coveragexml

## Publish
publish/
*.publish.xml

## Others
*.dbmdl
*.jfm

# Local history for Visual Studio
.localhistory/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# VS Code settings
.vscode/

# dotenv environment variables file
.env

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# Backup & report files from converting an old project file
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# NCrunch
*.ncrunch*
.*crunch*.local.xml

# MSTest test Results
TestResults/
*.VisualState.xml
*.TestResult.xml
*.trx

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Web resource caches
*.axd

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.log
*.vspscc
*.vssscc
*.cache
*.scc

# Dotnet generated files
project.lock.json
project.fragment.lock.json
artifacts/

# Azure Pipelines
.azure-pipelines/

# Local NuGet Packages
.nuget/

# JetBrains Rider
.idea/
*.sln.iml