<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework>net9.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>NeoMapper</PackageId>
    <Version>1.0.1</Version>
    <Authors>Francis Fulgencio</Authors>
    <Company>TuEmpresa</Company>
    <Description>NeoMapper es un mapeador genérico y ligero para .NET 8 que convierte entidades a DTOs y viceversa usando métodos de extensión y atributos personalizados.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/codeprofe/NeoMapper</RepositoryUrl>
    <PackageProjectUrl>https://github.com/codeprofe/NeoMapper</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mapper mapping dto entity automapper alternative reflection</PackageTags>
    <NeutralLanguage>es</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\"/>
    <None Include="../../LICENSE" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
